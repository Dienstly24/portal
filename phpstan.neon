# ARCH-4: statische Analyse (PHPStan + Larastan).
#
# Stufe 5 ist der im Auftrag genannte Zielwert und steht hier auch so drin -
# sie wurde NICHT gesenkt, um die Zahl der Meldungen kleiner aussehen zu
# lassen. Der Bestand hat auf dieser Stufe 290 Meldungen; sie stehen in
# phpstan-baseline.neon.
#
# Stand der Verkleinerung (Audit 15.09.2026): 307 -> 290. Herausgenommen
# wurden ausschliesslich Eintraege, deren URSACHE behoben ist - vier davon
# waren echte Fehler, die nur dank der Analyse auffielen (siehe
# docs/AUDIT_2026-09-15_BEHEBUNG.md). Was bewusst STEHEN BLEIBT und warum:
#   - Carbon::lokal() (11x): Laufzeit-Makro, statisch unsichtbar. Der
#     Versuch, es ueber eine Stub-Datei zu beschreiben, wurde gemessen und
#     VERWORFEN: eine Stub-Datei ERSETZT die Klasse, danach fehlten Carbon
#     alle uebrigen Methoden (35 Folgefehler quer durch den Bestand).
#   - nullsafe.neverNull / nullCoalesce.offset / notIdentical.alwaysTrue
#     (166x): das ist absichtlich defensiver Code. PHPStan haelt z.B.
#     auth()->user() fuer nie null - fuer einen Gast ist es das sehr wohl.
#     Diese Pruefungen zu entfernen, taeuschte Sauberkeit vor und erzeugte
#     echte Abstuerze.
#   - Aggregat-Aliase aus selectRaw ($anzahl, $netto, $monat ...): keine
#     Spalten, also auch keine Modell-Eigenschaften. Sie zu annotieren waere
#     eine Unwahrheit im Modell.
#
# Sinn der Baseline: ab sofort faellt jede NEUE Meldung in CI auf, waehrend
# der Altbestand die Einfuehrung des Werkzeugs nicht blockiert. Sie ist ein
# Uebergang, kein Dauerzustand - der Weg ist Baseline -> verkleinern ->
# entfernen. Wer eine Datei anfasst, sollte ihre Eintraege gleich mit
# aufraeumen und aus der Baseline streichen.
#
# Baseline neu erzeugen: composer stan:baseline
# Analyse laufen lassen:  composer stan

includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5

    paths:
        - app
        - config
        - database
        - routes

    # Migrationen sind Einwegskripte gegen ein Schema, das PHPStan nicht kennt;
    # die Blueprint-Aufrufe erzeugen dort nur Rauschen ohne Erkenntnis.
    excludePaths:
        - database/migrations

    # Larastan kann die Spalten eines Modells nicht kennen, solange sie nur in
    # einer Migration stehen - dynamische Eigenschaften sind hier Normalfall,
    # kein Fehler.
    checkModelProperties: false

