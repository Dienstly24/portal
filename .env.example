APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Rotierende Tageslogs mit Retention (Audit INT-7). In Produktion LOG_LEVEL=info.
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Empfehlung PRODUKTION (Audit PERF-3): Session/Cache/Queue auf Redis legen,
# damit nicht alles auf der einen MySQL konkurriert (Skalierung/Locking).
#   SESSION_DRIVER=redis · CACHE_STORE=redis · QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In PRODUKTION setzen (nur über HTTPS gültig): schützt das Session-Cookie.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# retry_after MUSS groesser als das laengste Job-Timeout sein (AnalyzeDocumentJob=300s)
DB_QUEUE_RETRY_AFTER=360

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Token für die WordPress-Website-Anfrage-API (fail-closed: ohne Wert
# werden unauthentifizierte Anfragen abgelehnt).
INQUIRY_TOKEN=

# lexoffice (Provisionsbelege, Kontakt-/Rechnungs-Sync). Kann auch über
# admin/settings gepflegt werden; DB-Wert hat Vorrang vor diesem Env.
LEXOFFICE_API_KEY=

# E-Mail-Postfächer per OAuth (Gmail / Microsoft 365). Ohne Werte sind
# nur IMAP/Hostinger-Postfächer nutzbar; OAuth-Konten melden dann klar
# "nicht konfiguriert". Redirect-URI: <APP_URL>/admin/email-accounts/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# KI-gestützte E-Mail-Auswertung (optional). Ohne Key bleibt die
# Verarbeitung voll funktionsfähig; die KI-Vorschlagsstufe ist inaktiv.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Optionales eigenes Modell fuer die Dokument-Analyse (Vision/PDF)
ANTHROPIC_DOCUMENT_MODEL=
# Austauschbarer KI-Anbieter fuer den Smart Document Upload (aktuell nur "claude")
AI_DOCUMENT_PROVIDER=claude
# Austauschbarer LLM-Anbieter der AI-Workflow-Engine (aktuell nur "claude";
# spaeter openai/gemini/azure ohne Engine-Aenderung)
AI_TEXT_PROVIDER=claude

# ---------------------------------------------------------------------------
# KI-KUNDENASSISTENT im Kundenportal (Betreiber-Auftrag 17.08.2026)
# ---------------------------------------------------------------------------
# Der Assistent nutzt im Standard CLAUDE - und damit DENSELBEN
# ANTHROPIC_API_KEY, der oben schon fuer die Dokumentanalyse gesetzt ist.
# Es ist KEIN zweiter Anbieter-Zugang noetig (Betreiber-Entscheidung
# 17.08.2026). Ein Anthropic-Schluessel funktioniert NIE bei OpenAI und
# umgekehrt - es sind getrennte Anbieter.
AI_ASSISTANT_PROVIDER=claude
# Modell des Assistenten (guenstiger: claude-sonnet-5)
# ANTHROPIC_ASSISTANT_MODEL=claude-opus-5
# Denkaufwand: low reicht fuer Kundenservice-Auskuenfte
# ANTHROPIC_ASSISTANT_EFFORT=low
# Deckelt Denk- UND Antwort-Tokens gemeinsam - nicht zu knapp setzen
# ANTHROPIC_ASSISTANT_MAX_TOKENS=4096
#
# ALTERNATIVE: OpenAI statt Claude (AI_ASSISTANT_PROVIDER=openai). Dann ist
# ein EIGENER Zugang noetig - Konto, Zahlungsmittel und ein zweiter
# Auftragsverarbeitungsvertrag. Der Schluessel gehoert ausschliesslich in
# die Server-.env (bzw. ein GitHub Secret): NIE ins Repository, ins HTML,
# in JavaScript oder in Logs.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
#
# Zeit-/Kostengrenzen (Voreinstellungen sind bewusst konservativ)
# AI_ASSISTANT_MAX_TOOL_ROUNDS=5
# AI_ASSISTANT_RATE_PER_HOUR=20
# AI_ASSISTANT_DAILY_LIMIT=500
#
# Achtung: Der Schluessel allein startet nichts. Der Assistent geht erst in
# Betrieb, wenn er in der Beraterwelt unter Einstellungen -> KI-Kunden-
# assistent eingeschaltet wird (Voreinstellung: AUS).

# Kostenlose OCR-Basisebene (Tesseract) fuer den Smart Document Upload:
# erst nach "apt install tesseract-ocr tesseract-ocr-deu poppler-utils"
# auf dem Server aktivieren (siehe CLAUDE.md). Fuer arabische Scans
# zusaetzlich "tesseract-ocr-ara" installieren und OCR_LANGUAGES=deu+eng+ara
# setzen. Vor dem Freischalten mit "php artisan ocr:check" pruefen, ob alle
# Binaries UND alle konfigurierten Sprachen wirklich installiert sind (eine
# fehlende Sprachdatei laesst sonst alles still zum bezahlten KI-Vision laufen).
OCR_ENABLED=false
OCR_LANGUAGES=deu+eng
# Falls die Binaries nicht im PATH liegen, koennen ihre Pfade gesetzt werden:
# OCR_TESSERACT_BINARY=/usr/bin/tesseract
# OCR_PDFTOTEXT_BINARY=/usr/bin/pdftotext
# OCR_PDFTOPPM_BINARY=/usr/bin/pdftoppm
# Leistungsgrenzen fuer OCR (schuetzen vor Timeouts auf schwacher Hardware):
# DPI der PDF-Rasterung, max. OCR-Seiten, hartes Gesamt-Zeitbudget (Sek.),
# Timeout je Seite. Reicht OCR im Budget nicht, eskaliert das System zur KI.
OCR_DPI=150
OCR_MAX_PAGES=10
OCR_MAX_SECONDS=60
OCR_PAGE_TIMEOUT=20
# Textebene folgt per Default OCR_ENABLED; separat schaltbar. (Audit ARCH-11)
# OCR_TEXT_LAYER=true
# Bei vorhandener Textebene bekommt die KI Text statt teurer Bildseiten;
# Kuerzungs-/Heuristik-Grenzen und KI-Antwort-Budget:
# OCR_AI_TEXT_MAX_CHARS=16000
# OCR_HEURISTIC_MAX_CHARS=2500
# Antwort-Budget der Dokument-Analyse: NICHT unter 2000 (das JSON umfasst
# Person/Vertrag/Fahrzeug/Energie; zu knapp schneidet die Antwort ab ->
# "Keine verwertbare Analyse-Antwort"). Default 4096.
# ANTHROPIC_DOCUMENT_MAX_TOKENS=4096
# Kostenbremse: wie oft ein Verwaltungs-Account pro Tag die ERZWUNGENE
# (kostenpflichtige) KI-Analyse "Mit KI analysieren" ausloesen darf. Der
# kostenlose Re-Run (Parser/OCR) ist davon nicht betroffen. Default 40.
# OCR_FORCE_AI_DAILY_LIMIT=40

# Meta Graph API (Banner-Social-Publishing Phase 2): direktes Posten auf
# die eigene Facebook-Seite + Instagram-Business. System-User-Token aus dem
# Business Manager (laeuft nicht ab). Einrichtung: docs/ANLEITUNG_META_API_AR.md
META_PAGE_ID=
META_IG_USER_ID=
META_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Schutzgrenze fuer Tagesbudgets aus dem System (EUR)
META_ADS_MAX_DAILY_BUDGET=100

# ---------------------------------------------------------------------------
# PASSWORT-SICHERHEIT (Betreiber-Vorgabe 18.08.2026)
# ---------------------------------------------------------------------------
# Gueltigkeit der SELBST angeforderten "Passwort vergessen"-Links in Minuten.
# Bewusst kurz. Portal-/Mitarbeiter-EINLADUNGEN laufen NICHT hierueber,
# sondern ueber einen signierten Link mit 14 Tagen Gueltigkeit - die brauchen
# lange Frist, ein Reset-Link nicht.
AUTH_PASSWORD_RESET_EXPIRE=60
#
# Abgleich jedes neuen Passworts gegen bekannte Datenlecks (HaveIBeenPwned,
# k-Anonymity - es geht nur ein 5-Zeichen-Hash-Praefix raus, nie das Passwort
# und nie die E-Mail-Adresse). Faellt der Dienst aus, gilt das Passwort als
# bestanden; der Abgleich kann also niemanden aussperren. Nur abschalten,
# wenn der Server dorthin keine ausgehende Verbindung hat.
PASSWORD_BREACH_CHECK=true
